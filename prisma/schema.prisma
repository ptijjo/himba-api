// Himba — schéma Prisma MVP
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LISTENER
  ARTIST
  ADMIN
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  BANNED
}

enum NotificationType {
  TRACK_RELEASE
  ALBUM_RELEASE
  NEW_FOLLOWER
}

/** Cible d’un signalement utilisateur. */
enum ReportTargetType {
  TRACK
  ARTIST
  USER
}

/** Motif de signalement (liste fermée). */
enum ReportReason {
  INAPPROPRIATE_CONTENT
  FRAUD_SCAM
  IMPERSONATION
  SPAM
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

/// Genres catalogue — ajouter une valeur = migration Prisma.
enum TrackGenre {
  RAP
  AFRO
  ZOUK
  SHATTA
  COUPE_DECALE
  DANCEHALL
  RNB
  POP
  GOSPEL
  REGGAE
  KOMPA
  OTHER
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String     @unique
  passwordHash String
  role         UserRole   @default(LISTENER)
  bio          String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  artist         Artist?
  playlists      Playlist[]
  follows         Follow[]
  favorites       Favorite[]
  albumFavorites  AlbumFavorite[]
  ratings         Rating[]
  playEvents      PlayEvent[]
  purchases       Purchase[]
  albumPurchases  AlbumPurchase[]
  pushTokens      DevicePushToken[]
  notifications   Notification[]
  reportsFiled    Report[]         @relation("ReportsFiled")

  @@index([email])
  @@index([username])
  @@map("users")
}

model Artist {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  albums   Album[]
  tracks   Track[]
  follows  Follow[]
  ratings  Rating[]

  @@map("artists")
}

model Album {
  id          String   @id @default(cuid())
  artistId    String
  title       String
  description String?
  /** Cover obligatoire (upload Sharp→WebP à la création) */
  coverUrl    String
  /** null = non vendu en bundle ; sinon prix en euros (Decimal) */
  price       Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artist     Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks     Track[]
  purchases  AlbumPurchase[]
  favorites  AlbumFavorite[]

  @@index([artistId])
  @@index([createdAt])
  @@map("albums")
}

model Track {
  id             String   @id @default(cuid())
  artistId       String
  albumId        String?
  albumPosition  Int?
  title          String
  /** Obligatoire — enum TrackGenre (RAP, AFRO, ZOUK, SHATTA…) */
  genre          TrackGenre
  /** null = gratuit ; sinon prix en euros (Decimal) */
  price          Decimal? @db.Decimal(12, 2)
  audioObjectKey String
  coverUrl       String?
  durationMs     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  artist          Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album           Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  playlistTracks  PlaylistTrack[]
  favorites       Favorite[]
  ratings         Rating[]
  playEvents      PlayEvent[]
  purchases       Purchase[]

  @@index([artistId])
  @@index([albumId, albumPosition])
  @@index([genre])
  @@index([createdAt])
  @@map("tracks")
}

model Playlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistTrack {
  id         String @id @default(cuid())
  playlistId String
  trackId    String
  position   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
  @@map("playlist_tracks")
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  artistId   String
  createdAt  DateTime @default(now())

  follower User   @relation(fields: [followerId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([followerId, artistId])
  @@index([artistId])
  @@map("follows")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@map("favorites")
}

model AlbumFavorite {
  id        String   @id @default(cuid())
  userId    String
  albumId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([albumId])
  @@map("album_favorites")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  trackId   String?
  artistId  String?
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  track  Track?  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist? @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@unique([userId, artistId])
  @@index([trackId])
  @@index([artistId])
  @@map("ratings")
}

model PlayEvent {
  id         String   @id @default(cuid())
  userId     String
  trackId    String
  listenedAt DateTime @default(now())
  progressMs Int?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, listenedAt])
  @@index([trackId])
  @@map("play_events")
}

model Purchase {
  id                        String   @id @default(cuid())
  userId                    String
  trackId                   String
  /** Montant payé en euros */
  amount                    Decimal  @db.Decimal(12, 2)
  platformCommissionPercent Int
  artistAmount              Decimal  @db.Decimal(12, 2)
  stripePaymentId           String?  @unique
  createdAt                 DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([trackId])
  @@map("purchases")
}

model AlbumPurchase {
  id                        String   @id @default(cuid())
  userId                    String
  albumId                   String
  /** Montant payé en euros */
  amount                    Decimal  @db.Decimal(12, 2)
  platformCommissionPercent Int
  artistAmount              Decimal  @db.Decimal(12, 2)
  stripePaymentId           String?  @unique
  createdAt                 DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([albumId])
  @@map("album_purchases")
}

/** Token Expo Push — un appareil = un token (upsert par token). */
model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  /** ExponentPushToken[…] */
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_push_tokens")
}

/** Fil d’alertes in-app + miroir des push sorties. */
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  /** artistId, trackId?, albumId? */
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/** Signalement (fraude, contenu inapproprié, spam, …) — traité par admin. */
model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  reporter User @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}
